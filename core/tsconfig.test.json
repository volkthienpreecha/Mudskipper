{
  // Tests and scripts run in Node, so they get @types/node; core's source is re-checked under Node's type set.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src", "test", "scripts/*.ts", "vitest.config.ts"],
  "exclude": []
}
