{
  "name": "@mudskipper/core",
  "version": "0.1.0",
  "private": true,
  "description": "The one implementation of Mudskipper's rules: simulation, verdicts, ranking, story, states, typed API client.",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./client": "./src/client.ts",
    "./fixtures-vite": "./src/fixtures-vite.ts",
    "./fixtures-node": "./src/fixtures-node.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "gen:check": "node scripts/gen-types.mjs --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.dom.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "compute-run": "node scripts/compute-run.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
