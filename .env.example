# Copy to .env and fill in locally. .env is gitignored; never commit secrets.
# No script reads this file implicitly: each script documents the keys it needs.

# NASA Earthdata login (pipeline/: ASF search and bounded GCOV reads)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Which run directory under artifacts/ to build and publish
RUN_ID=r01

# Study tiles, id:minLon,minLat,maxLon,maxLat separated by ';'.
# The real tiles chosen by geo/tiles.py (geo/tiles.json, DECISIONS K-101/K-102): 15 x 15 km squares in EPSG:32643
# with south-west corners fazilka 432500,3389500 and muktsar 445500,3345500; these are their lon/lat envelopes,
# exactly as geo/grid.py writes them into artifacts/<run_id>/aoi.json. (Fixture tiles: contracts/fixtures/run/aoi.json.)
AOI_TILES=fazilka:73.951201,30.331645,74.108672,30.468147;muktsar:74.441436,30.401967,74.598362,30.537898

# Kharif 2026 provisional NISAR window (CRID P05023), see contracts/CONTRACTS.md B3.1
SEASON_START=2026-06-17
SEASON_END=2026-10-23

# Cloudflare (CI secrets only; local deploys use `wrangler login`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
