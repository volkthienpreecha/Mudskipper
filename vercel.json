{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --workspace=@mudskipper/app",
  "outputDirectory": "app/dist",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mudskipper-nisar.pages.dev/api/:path*" },
    { "source": "/tiles/:path*", "destination": "https://mudskipper-nisar.pages.dev/tiles/:path*" },
    { "source": "/((?!assets/|fonts/|favicon.svg|robots.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
