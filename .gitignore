# Secrets — never commit. Copy .env.example to .env and fill locally.
.env
.env.*
!.env.example
.dev.vars

# Data and run outputs (published to R2/D1 by `make publish`, never committed)
data/
artifacts/
*.h5
*.tif

# Tooling
node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.wrangler/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Platform build output (assembled site + static API) and local Wrangler state
platform/.site/
*.tsbuildinfo

# Platform caches (OG render fonts, local D1/KV state)
platform/.cache/

# Rehearsal runs (platform/scripts/rehearsal/make_rehearsal.py): SAMPLE data at real scale, rebuilt on demand
platform/.rehearsal/

# Claude Code agent worktrees
.claude/
