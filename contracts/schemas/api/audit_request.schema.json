{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mudskipper.invalid/schemas/v1/api/audit_request.schema.json",
  "title": "POST /api/audit (request)",
  "description": "Claims to rank, an inspection budget and an optional seed.",
  "type": "object",
  "properties": {
    "claims": {
      "$ref": "../claims.schema.json"
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "claims",
    "budget"
  ],
  "additionalProperties": false
}
