{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mudskipper.invalid/schemas/v1/claims.schema.json",
  "title": "claims (FeatureCollection)",
  "description": "Program claims to rank for inspection: claims.sample.geojson and POST /api/audit. Accepts ordinary GIS exports (extra members such as name/crs/bbox, extra properties, altitude in positions); see CONTRACTS.md B3.12.",
  "type": "object",
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/v"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "fixture": {
      "$ref": "common.schema.json#/$defs/fixture"
    },
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1,
      "maxItems": 5000
    }
  },
  "required": [
    "type",
    "features"
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "$ref": "#/$defs/polygon"
            },
            {
              "$ref": "#/$defs/multipolygon"
            }
          ]
        },
        "properties": {
          "$ref": "#/$defs/claim_properties"
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ]
    },
    "claim_properties": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "claimed": {
          "type": "array",
          "items": {
            "enum": [
              "awd",
              "dsr"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "synthetic": {
          "type": "boolean"
        },
        "field_id": {
          "$ref": "common.schema.json#/$defs/field_id"
        },
        "area_ha": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "claimed",
        "synthetic"
      ]
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "description": "[lon, lat] or [lon, lat, altitude]; altitude is ignored"
    },
    "point": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "polygon": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/position"
            },
            "minItems": 4
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "multipolygon": {
      "type": "object",
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              },
              "minItems": 4
            },
            "minItems": 1
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    }
  }
}
