{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mudskipper.invalid/schemas/v1/common.schema.json",
  "title": "Mudskipper shared definitions",
  "description": "Shared $defs referenced by every other schema. CONTRACTS.md C0.",
  "$defs": {
    "v": {
      "const": 1,
      "description": "Contract version."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "fixture": {
      "type": "boolean",
      "description": "true on fixture (sample) data; the app shows SAMPLE DATA."
    },
    "tile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}$"
    },
    "field_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,15}-[0-9]{5}$"
    },
    "pass_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-T[0-9]{3}[AD]$"
    },
    "granule_id": {
      "type": "string",
      "pattern": "^(SAMPLE_)?NISAR_L2_(PR|UR|OD)_GCOV_[0-9]{3}_[0-9]{3}_[AD]_[0-9]{3}_[0-9]{4}_[A-Z]{4}_[AM]_[0-9]{8}T[0-9]{6}_[0-9]{8}T[0-9]{6}_[A-Z][0-9]{5}_[PMNF]_[FP]_[A-Z]_[0-9]{3}$",
      "description": "Full NISAR GCOV granule name without extension. Fixtures prefix SAMPLE_."
    },
    "crid": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{5}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prob": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "db": {
      "type": "number",
      "minimum": -80,
      "maximum": 40
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "tag": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "ASSUMED"
      ]
    },
    "stage": {
      "enum": [
        "early",
        "mid",
        "late"
      ]
    },
    "state": {
      "enum": [
        "flooded",
        "drained",
        "uncertain"
      ]
    },
    "method": {
      "enum": [
        "fd_gmm_v1",
        "hhhv_v1"
      ]
    },
    "pol_mode": {
      "enum": [
        "QP",
        "DH"
      ]
    },
    "direction": {
      "enum": [
        "ascending",
        "descending"
      ]
    },
    "verdict": {
      "enum": [
        "consistent",
        "inconsistent",
        "not_enough_evidence"
      ]
    },
    "dsr_signal": {
      "enum": [
        "dsr_signal",
        "transplant_signal",
        "unknown"
      ]
    },
    "field_source": {
      "enum": [
        "ftw",
        "manual",
        "grid"
      ]
    },
    "district": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false,
      "description": "[minLon, minLat, maxLon, maxLat]"
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "linear_ring": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/position"
      },
      "minItems": 4
    },
    "polygon": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/linear_ring"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "multipolygon": {
      "type": "object",
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/linear_ring"
            },
            "minItems": 1
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "common.schema.json#/$defs/position"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "area_geometry": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/polygon"
        },
        {
          "$ref": "common.schema.json#/$defs/multipolygon"
        }
      ]
    },
    "gap": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/url"
        }
      },
      "required": [
        "start",
        "end",
        "source"
      ],
      "additionalProperties": false
    },
    "tile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/tile_id"
        },
        "district": {
          "$ref": "common.schema.json#/$defs/district"
        },
        "bbox": {
          "$ref": "common.schema.json#/$defs/bbox"
        }
      },
      "required": [
        "id",
        "district",
        "bbox"
      ],
      "additionalProperties": false
    },
    "season": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "properties": {
        "mid_start": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "late_start": {
          "$ref": "common.schema.json#/$defs/date"
        }
      },
      "required": [
        "mid_start",
        "late_start"
      ],
      "additionalProperties": false
    }
  }
}
