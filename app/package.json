{
  "name": "@mudskipper/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/data.test.ts",
    "test:a11y": "node --test --test-concurrency=1 test/a11y.test.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@mudskipper/core": "*",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
