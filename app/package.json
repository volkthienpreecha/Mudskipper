{
  "name": "@mudskipper/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/data.test.ts",
    "test:a11y": "node --test --test-concurrency=1 test/a11y.test.ts"
  },
  "dependencies": {
    "@mudskipper/core": "*",
    "maplibre-gl": "6.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
